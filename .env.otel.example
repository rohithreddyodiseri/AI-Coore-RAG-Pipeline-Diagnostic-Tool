# Copy to .env.otel in the repository root and use the onboarding values.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20REPLACE_WITH_APP_INGESTION_TOKEN
OTEL_SERVICE_NAME=reference-rag
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=staging
# Enable only when query, context, and answer capture is permitted.
RAG_TRACE_CONTENT=0
OTEL_BSP_SCHEDULE_DELAY=1000
